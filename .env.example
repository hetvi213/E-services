SECRET_KEY=replace-with-a-long-random-value
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gov_services

# Public contact information shown in the footer and Contact Us page
PORTAL_ADDRESS=Krishi Seva Kendra, Main Road, Ahmedabad, Gujarat
PORTAL_EMAIL=support@example.com
PORTAL_PHONE=+91 98765 43210

# Administrator notification email and SMTP credentials
ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Administrator dashboard login (use a strong unique password)
ADMIN_LOGIN_EMAIL=admin@example.com
ADMIN_LOGIN_PASSWORD=replace-with-a-strong-admin-password

# Alternatively, set the complete URI (URL-encode special characters):
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:password@127.0.0.1:3306/gov_services?charset=utf8mb4
